<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout">
  <l:layout title="Parameter value">
    <l:main-panel>
      <j:set var="build" value="${it.run}"/>
      <j:set var="readOnlyMode" value="true"/>
      <st:include it="${it.value}" page="value.jelly"/>
    </l:main-panel>
  </l:layout>
</j:jelly>
